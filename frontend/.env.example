# Set to "false" once the FastAPI/Flask backend is running.
# While "true" (default) the app uses the in-memory mock API in lib/mock and
# shows a "Simulated data" badge everywhere.
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the backend (only used when NEXT_PUBLIC_USE_MOCK=false)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
